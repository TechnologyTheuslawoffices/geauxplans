    {
      "contentType": "",
      "_id": "65e0b23792f8a5481be3a6ab",
      "name": "InitialsSuggest",
      "isList": true,
      "label": "",
      "expression": "[\"this.Middle\\r\\n   ? (this.First.first(1)|lower) + (this.Middle.first(1)|lower) + (this.Last.first(1)|lower)\\r\\n   : (this.First.first(1)|lower) + (this.Last.first(1)|lower)\"]",
      "ref": "",
      "type": "text"
    },
    {
