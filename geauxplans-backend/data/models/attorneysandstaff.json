  "formulas": [
    {
      "contentType": "",
      "_id": "65e0064c1c9bf0999c2aaf3d",
      "name": "FullName",
      "isList": false,
      "label": "",
      "expression": "this.Middle\n  ? this.Suffix\n     ? this.First + \" \" + this.Middle + \" \" + this.Last + \", \" + this.Suffix\n     : this.First + \" \" + this.Middle + \" \" + this.Last\n  : Suffix\n     ? this.First + \" \" + this.Last + \", \" + this.Suffix\n     : this.First + \" \"  + this.Last",
      "ref": "",
      "type": "text"
    },
    {
      "_id": "65e00d6e7f40c5204137d592",
      "name": "IsAttorneyTF",
      "isList": false,
      "label": "",
      "expression": "(this.Roles|contains: \"Attorney\")",
      "ref": "",
      "type": "true/false"
    },
    {
      "_id": "65e00d7e7f40c5204137d593",
      "name": "IsNotaryTF",
      "isList": false,
      "label": "",
      "expression": "(this.Roles|contains: \"Notary\")",
      "ref": "",
      "type": "true/false"
    },
    {
      "_id": "65e00e707f40c5204137d599",
      "name": "TrueAddress",
      "isList": false,
      "label": "",
      "expression": "this.UseFirmAddressTF\n   ? this.SelectAddress\n   : this.Address",
      "ref": "address",
      "type": "object"
    },
    {
      "contentType": "",
      "_id": "65e00f287f40c5204137d59d",
      "name": "Street2",
      "isList": false,
      "label": "",
      "expression": "this.TrueAddress.StreetAddress2\n   ? this.TrueAddress.StreetAddress2\n   : null",
      "ref": "",
      "type": "text"
    },
    {
      "contentType": "",
      "_id": "65e0111b3259e4a1194f145f",
      "name": "Name",
      "isList": false,
      "label": "",
      "expression": "this.UseName\n  ? this.UseName\n  : this.First",
      "ref": "",
      "type": "text"
    },
    {
      "contentType": "",
      "_id": "65e0149a3259e4a1194f1461",
      "name": "Phone",
      "isList": false,
