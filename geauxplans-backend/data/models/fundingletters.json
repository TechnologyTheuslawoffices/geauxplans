{
  "_id": "60c100709c6497102bdbeed2",
  "summary": "{[LetterType|else: \"New\"]} Letter{[if LetterType && ((LetterType == \"Entity (Partnership, LLC, or Corporation)\" && EntitySelect) || LetterType != \"Entity (Partnership, LLC, or Corporation)\" && RecipientTo)]} to {[RecipientTo]}{[endif]}",
  "label": "",
  "type": "object",
  "name": "fundingletters",
  "formulas": [
    {
      "contentType": "",
      "isList": false,
      "label": "",
      "expression": "this.LetterType == \"Bank Account, CD, or Money Market Account\"\n    ? this.BankSelect\n      ? this.BankSelect.AssetLetterRef\n      : null\n    : this.LetterType == \"Brokerage or Mutual Fund Account\"\n       ? this.BrokerageSelect\n         ? this.BrokerageSelect.AssetLetterRef\n         : null\n       : this.LetterType == \"Life Insurance\"\n          ? this.LifeInsureSelect\n             ? this.LifeInsureSelect.AssetLetterRef\n             : null\n          : this.LetterType == \"Non-Qualified Annuities\"\n             ? this.AnnuitySelec\n                ? this.AnnuitySelec.AssetLetterRef\n                : null\n             : this.LetterType == \"Entity (Partnership, LLC, or Corporation)\"\n                ? this.EntitySelect\n                  ? this.EntitySelect.AssetLetterRef\n                  : null\n                : (LetterType == \"Stocks\" || LetterType == \"Bonds\")\n                   ? StockBondSelect\n                     ? StockBondSelect.AssetLetterRef\n                     : null\n                   : null\n   ",
      "ref": "",
      "type": "text",
      "name": "AssetRefName",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-06-16T19:00:37.550Z",
      "_id": "645a77d375e3bc45ef94cb79"
    },
    {
      "isList": true,
      "label": "",
      "expression": "[\"peek(ExistingLLCs)\\n  ? ExistingLLCs\\n  : []\",\"peek(LLCs)\\n  ? LLCs\\n  : []\",\"CombinedCorpAssets.length > 0\\r\\n   ? (CombinedCorpAssets|map: AsLLC)\\r\\n   : []\"]",
      "ref": "llcinfo",
      "type": "object",
      "name": "EntitySuggestions",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-06-16T19:11:21.994Z",
      "_id": "645a77d375e3bc45ef94cb7a"
    },
    {
      "contentType": "",
      "isList": true,
      "label": "",
      "expression": "[\"Client.PartyLineAddress\",\"MarriedTF && !Spouse.SameAddressTF\\r\\n  ? Spouse.LineAddress\\r\\n  : null\",\"(FundAssets|any: AcctType == \\\"Real\\\")\\n   ? (RealEstateAssets|map: RealStreetAddress)\\n   : []\"]",
      "ref": "",
      "type": "text",
      "name": "FundPropertySuggestions",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-08-16T21:50:19.068Z",
      "_id": "645a77d375e3bc45ef94cb7b"
    },
    {
      "contentType": "",
      "isList": true,
      "label": "",
      "expression": "[\"((EntitySuggestions|group: this)|map: _key)\"]",
      "ref": "",
      "type": "text",
      "name": "GroupEntitySuggestions",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-06-15T19:05:58.777Z",
      "_id": "645a77d375e3bc45ef94cb7c"
    },
    {
      "isList": false,
      "label": "",
      "expression": "peek(TransferTo == \"Entity\")",
      "ref": "",
      "type": "true/false",
      "name": "IsLLC",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-11-29T18:57:54.583Z",
      "_id": "645a77d375e3bc45ef94cb7d"
    },
    {
      "isList": false,
      "label": "",
      "expression": "MarriedTF\n  ? EmployeePlanSelect == \"Client\"\n    ? Client\n    : EmployeePlanSelect == \"Spouse\"\n      ? Spouse\n      : null\n  : Client",
      "ref": "individual",
      "name": "PlanTrueOwner",
      "type": "object",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-09-20T15:42:14.898Z",
      "_id": "645a77d375e3bc45ef94cb7e"
    },
    {
      "contentType": "",
      "isList": true,
      "label": "",
      "expression": "[\"LetterType == \\\"Brokerage or Mutual Fund Account\\\" && (FundAssets|any: AcctType == \\\"Broker\\\")\\n   ? (BrokerAssets|map: AcctBank)\\n   : []\",\"LetterType == \\\"Life Insurance\\\" && (FundAssets|any: AcctType == \\\"LifeInsure\\\")\\n   ? (LifeInsureAssets|map: AcctBank)\\n   : []\",\"LetterType == \\\"Entity (Partnership, LLC, or Corporation)\\\"\\n   ? (EntitySelect.AcctType == \\\"LLC\\\" ? \\\"Manager\\\" : (EntitySelect.AcctType == \\\"Corporate\\\" || EntitySelect.AcctType == \\\"SoleProp\\\") ? \\\"Director(s)\\\" : (EntitySelect.AcctType == \\\"Partnership\\\") ? \\\"Managing Partner\\\" : \\\"Manager, Director(s), or Managing Partner\\\") + \\\" of \\\" + (EntitySelect.AcctBank|else: \\\"\\\")\\n   : []\",\"LetterType == \\\"Bank Account, CD, or Money Market Account\\\" && (FundAssets|any: AcctType == \\\"Cash\\\")\\n   ? (CashAssets|map: AcctBank)\\n   : []\",\"LetterType == \\\"Non-Qualified Annuities\\\" && (FundAssets|any: AcctType == \\\"Annuity\\\")\\n   ? (AnnuityAssets|map: AcctBank)\\n   : []\",\"LetterType == \\\"Retirement Account\\\" && (FundAssets|any: AcctType == \\\"Retirement\\\")\\n   ? (RetirementAssets|map: AcctBank)\\n   : []\",\"(LetterType == \\\"Stocks\\\") && StockAssets.length > 0\\n   ? (StockAssets|map: AcctBank)\\n   : []\",\"(LetterType == \\\"Bonds\\\") && BondAssets.length > 0\\n   ? (BondAssets|map: AcctBank)\\n   : []\"]",
      "ref": "",
      "type": "text",
      "name": "RecipientSuggestions",
      "lastModifiedBy": "5fe0c5547241dc6f81146408",
      "lastModified": "2021-07-09T20:39:51.062Z",
      "_id": "645a77d375e3bc45ef94cb7f"
    },
    {
      "isList": false,
