    {
      "name": "ParishCounty",
      "isList": false,
      "label": "",
      "expression": "this.id$ == Client.id$ || (MarriedTF && this.id$ == Spouse.id$ && this.SameAddressTF) || peek(this.SameAddressTF)\n    ? (Client.State.ParishCounty|else: \"Parish or County\")\n    : (this.State.ParishCounty|else: \"Parish or County\")",
      "ref": "",
      "_id": "68d2bc61a7b88525a4761d7d",
      "type": "text",
      "contentType": ""
    },
    {
      "name": "EntityCO",
      "isList": false,
      "label": "",
      "expression": "this.AAn + \" \" + (this.OrgState|else: \"_________________\") + \" \" + (this.EntityType|else: \"______________\")",
      "ref": "",
      "_id": "68d2bc61a7b88525a4761d79",
      "type": "text",
      "contentType": ""
    },
    {
      "name": "IndividualTF",
      "isList": false,
      "label": "",
      "expression": "this.PartyType && this.PartyType != \"Entity\"",
